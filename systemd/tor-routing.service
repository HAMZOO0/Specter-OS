[Unit]
Description=Specter OS transparent Tor routing and kill-switch
Documentation=https://github.com/HAMZOO0/Specter-OS
# Run in early boot, before any network interface is configured,
# so there is no window in which traffic can bypass Tor.
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service
Before=network-pre.target tor.service NetworkManager.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tor-routing.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
