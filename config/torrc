## Specter OS - /etc/tor/torrc
## Minimal client configuration for transparent proxying.
## All listeners are bound to loopback only.

SocksPort 127.0.0.1:9050

# Map hostnames resolved through Tor to a private virtual range
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1

# Transparent TCP proxy (target of the iptables REDIRECT rule)
TransPort 127.0.0.1:9040 IsolateClientAddr IsolateDestAddr IsolateDestPort

# DNS resolver (target of the UDP/53 REDIRECT rule)
DNSPort 127.0.0.1:5353

# Never use IPv6 for outgoing connections
ClientUseIPv6 0
ClientPreferIPv6ORPort 0
